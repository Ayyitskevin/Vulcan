# Vulcan usage reporter — operator configuration.
#
# Copy to /home/kevin-lee/deploy/vulcan-data/usage-reporter.env and
# chmod 600. The Athena source secret is shown ONCE at registration (see
# deploy/README.md, "Usage reporter") and Athena stores it plaintext — HMAC
# verification needs the shared value itself — so treat this file like the
# credential it is: never in the repo, never in the unit.

# Registered forge source name (POST /event-sources, one time, admin token).
ATHENA_FORGE_SOURCE=vulcan
# One-time secret from that registration response (evtsec_…).
ATHENA_FORGE_SECRET=evtsec_REPLACE_WITH_ONE_TIME_SECRET
# A REAL issue the digest lands on as imported history, e.g. a standing
# "Vulcan daily usage digest" issue. The reporter fails loudly when a
# delivery lands nowhere, so a typo here cannot go unnoticed.
ATHENA_ISSUE_KEY=VUL-1

# Defaults shown; override only if your layout differs. Athena's loopback
# refuses — use the tailnet address even on the same host.
#ATHENA_BASE_URL=http://100.125.80.91:8300
#VULCAN_USAGE_URL=http://127.0.0.1:8140/v1/usage
#USAGE_REPORTER_STATE=/home/kevin-lee/deploy/vulcan-data/usage-reporter-state.json
